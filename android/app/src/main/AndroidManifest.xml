<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Geidea's own SDK doc (§3.1, extracted from
         Geidea_Android_SDK_v1.3.0.rar) lists only these two — both already
         present. There's no such manifest permission as
         "android.permission.USB" (the earlier condensed spec doc's §3.2
         had it, but it isn't a real Android permission constant, and the
         real vendor PDF doesn't list one either); USB host access is
         granted at runtime by the SDK itself via UsbManager. -->
    <application
        android:label="Waha Kiosk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Falls back to the older Skia renderer instead of Impeller
             (Flutter's current default on Android). A logcat capture from a
             kiosk device showed repeated gralloc4 "unsupported format"
             buffer-allocation failures immediately before the Flutter
             engine's native side detached (FlutterJNI ... detached from
             native C++) — the signature of a GPU driver that can't satisfy
             whatever texture format Impeller's renderer requests on first
             frame. This is a real, if narrow, class of device (low-end/old
             SoC GPU drivers with incomplete gralloc HAL implementations),
             not something app code can guard against — the standard,
             documented mitigation is reverting to Skia for the affected
             build. There is no dart-define equivalent for this; it's
             manifest-only because it has to be baked into a shipped release
             APK, not something toggled at runtime. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- ML Kit (pulled in transitively by mobile_scanner's barcode
             scanning) auto-registers this provider to initialize itself at
             app PROCESS startup — before any Activity, unconditionally,
             whether or not the customer ever opens the scanner. On old/
             low-end kiosk hardware that may not have Google Play Services
             at all, that eager init is a plausible source of a startup-time
             crash with no way to opt out except removing the provider
             outright. Barcode scanning still works fine lazily-initialized
             on first real use, which is what happens once this is gone. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
