        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reference_counter\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"last_serial\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
