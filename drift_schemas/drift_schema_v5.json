  "fixed_sql": [
    {
      "name": "local_products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_products\" (\"id\" INTEGER NOT NULL, \"barcode\" TEXT NULL, \"sku\" TEXT NULL, \"name_json\" TEXT NOT NULL, \"description_json\" TEXT NULL, \"price\" TEXT NOT NULL, \"price_with_vat\" TEXT NOT NULL, \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"is_public\" INTEGER NOT NULL CHECK (\"is_public\" IN (0, 1)), \"category_id\" INTEGER NULL, \"image_resource_id\" INTEGER NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_barcodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_barcodes\" (\"id\" INTEGER NOT NULL, \"product_id\" INTEGER NOT NULL, \"barcode\" TEXT NOT NULL, \"is_primary\" INTEGER NOT NULL CHECK (\"is_primary\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_categories\" (\"id\" INTEGER NOT NULL, \"name_json\" TEXT NOT NULL, \"key\" TEXT NULL, \"is_public\" INTEGER NOT NULL CHECK (\"is_public\" IN (0, 1)), \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"image_resource_id\" INTEGER NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_payment_methods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_payment_methods\" (\"id\" INTEGER NOT NULL, \"key\" TEXT NOT NULL, \"display_name_json\" TEXT NULL, \"provider\" TEXT NOT NULL, \"available_modes\" TEXT NULL, \"offline_capable\" INTEGER NOT NULL CHECK (\"offline_capable\" IN (0, 1)), \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"payment_url\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_store_payment_methods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_store_payment_methods\" (\"id\" INTEGER NOT NULL, \"payment_method_id\" INTEGER NOT NULL, \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"sort_order\" INTEGER NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_product_images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_product_images\" (\"id\" INTEGER NOT NULL, \"product_id\" INTEGER NOT NULL, \"resource_id\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"feed\" TEXT NOT NULL, \"since\" TEXT NULL, \"after_id\" INTEGER NOT NULL DEFAULT 0, \"full_pull_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"full_pull_done\" IN (0, 1)), \"last_pull_at\" TEXT NULL, \"last_error\" TEXT NULL, PRIMARY KEY (\"feed\"));"
        }
      ]
    },
    {
      "name": "device_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"device_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"device_id\" INTEGER NOT NULL, \"device_no\" INTEGER NOT NULL, \"store_id\" INTEGER NOT NULL, \"organization_id\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"vat_rate\" TEXT NOT NULL, \"prices_include_vat\" INTEGER NOT NULL CHECK (\"prices_include_vat\" IN (0, 1)), \"short_code\" TEXT NULL, \"invoice_base_url\" TEXT NULL, \"last_reference_serial\" INTEGER NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_orders\" (\"order_id\" TEXT NOT NULL, \"order_reference\" TEXT NOT NULL, \"display_id\" INTEGER NULL, \"store_id\" INTEGER NOT NULL, \"username\" TEXT NULL, \"status\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"tax_rate\" TEXT NOT NULL, \"subtotal_amount\" TEXT NOT NULL, \"tax_amount\" TEXT NOT NULL, \"total_amount\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"paid_at\" TEXT NULL, \"sync_state\" TEXT NOT NULL DEFAULT 'LOCAL', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" TEXT NULL, \"last_error_code\" TEXT NULL, \"last_error\" TEXT NULL, \"synced_at\" TEXT NULL, PRIMARY KEY (\"order_id\"));"
        }
      ]
    },
    {
      "name": "local_order_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_order_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"order_id\" TEXT NOT NULL REFERENCES local_orders (order_id), \"line_no\" INTEGER NOT NULL, \"product_id\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL, \"unit_price\" TEXT NOT NULL, \"line_net\" TEXT NOT NULL, \"line_tax\" TEXT NOT NULL, \"name_json\" TEXT NULL, \"display_unit_price\" TEXT NULL, UNIQUE (\"order_id\", \"line_no\"));"
        }
      ]
    },
    {
      "name": "local_payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_payments\" (\"payment_id\" TEXT NOT NULL, \"order_id\" TEXT NOT NULL REFERENCES local_orders (order_id), \"provider\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"provider_reference\" TEXT NULL, \"auth_code\" TEXT NULL, \"notes_json\" TEXT NULL, \"late_approval\" INTEGER NOT NULL DEFAULT 0 CHECK (\"late_approval\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"synced_at\" TEXT NULL, PRIMARY KEY (\"payment_id\"));"
        }
      ]
    },
    {
      "name": "reference_counter",
