  "fixed_sql": [
    {
      "name": "local_products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_products\" (\"id\" INTEGER NOT NULL, \"barcode\" TEXT NULL, \"sku\" TEXT NULL, \"name_json\" TEXT NOT NULL, \"description_json\" TEXT NULL, \"price\" TEXT NOT NULL, \"price_with_vat\" TEXT NOT NULL, \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"is_public\" INTEGER NOT NULL CHECK (\"is_public\" IN (0, 1)), \"category_id\" INTEGER NULL, \"image_resource_id\" INTEGER NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_barcodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_barcodes\" (\"id\" INTEGER NOT NULL, \"product_id\" INTEGER NOT NULL, \"barcode\" TEXT NOT NULL, \"is_primary\" INTEGER NOT NULL CHECK (\"is_primary\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_categories",
      "sql": [
        {
          "dialect": "sqlite",
